{
  "name": "n8n-nodes-ictcontact",
  "version": "0.1.4",
  "description": "n8n community node for ICTContact and ICTDialer.com. Run campaigns, manage contacts and users from a workflow.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "ictcontact",
    "ictdialer",
    "contact-center",
    "call-center",
    "auto-dialer",
    "predictive-dialer",
    "telephony",
    "voip",
    "asterisk"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ictinnovations/n8n-nodes-ictcontact",
  "author": {
    "name": "Tahir Almas",
    "email": "tahir@ictinnovations.com",
    "url": "https://ictinnovations.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ictinnovations/n8n-nodes-ictcontact.git"
  },
  "bugs": {
    "url": "https://github.com/ictinnovations/n8n-nodes-ictcontact/issues"
  },
  "engines": {
    "node": ">=20.15"
  },
  "main": "index.js",
  "scripts": {
    "build": "rimraf dist && tsc && gulp build:icons",
    "dev": "tsc --watch",
    "lint": "eslint .",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "index.js",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/IctContactApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/IctContact/IctContact.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/eslint-plugin-community-nodes": "^0.28.0",
    "@types/node": "^20.19.0",
    "eslint": "9.29.0",
    "eslint-plugin-n8n-nodes-base": "^2.0.0",
    "gulp": "^5.0.0",
    "jsonc-eslint-parser": "^2.4.2",
    "n8n-workflow": "*",
    "rimraf": "^5.0.5",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.66.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
